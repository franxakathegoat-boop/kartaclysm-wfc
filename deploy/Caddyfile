# Port 80 belongs to wwfc (the Wii talks plain HTTP to nas.<domain>), so Caddy only serves 443
# and gets its certificate with the TLS-ALPN challenge.
{
	# "email you@example.com" or empty (install.sh): the certificate e-mail is optional
	{$ACME_EMAIL_OPTION}
	http_port 8880
	auto_https disable_redirects
}

stats.{$DOMAIN}, {$DOMAIN} {
	encode gzip
	@api path /api/stats /api/groups /api/leaderboard /api/vrhistory
	handle @api {
		reverse_proxy 127.0.0.1:80
	}
	# per-region game patches (stage0) that the Kartaclysm launcher downloads; built by install.sh
	handle_path /client/* {
		root * /srv/client
		file_server
	}
	handle {
		root * /srv/web
		file_server
	}
}
