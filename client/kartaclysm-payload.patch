 static bool IsRaceCourse(ECourse course)
 {
+#  if KARTACLYSM
+    // Kartaclysm (LE-CODE): custom tracks use slots 0x44..KARTACLYSM_LAST_SLOT
+    if (course >= static_cast<ECourse>(0x44) &&
+        course <= static_cast<ECourse>(KARTACLYSM_LAST_SLOT)) {
+        return true;
+    }
+#  endif
     return course >= ECourse::MARIO_CIRCUIT && course <= ECourse::GBA_SHY_GUY_BEACH;
 }
 
+static bool IsRaceCourseVote(ECourse course)
+{
+#  if KARTACLYSM
+    // LE-CODE random choices (slots 0x3D..0x41) are only valid as a vote
+    if (course >= static_cast<ECourse>(0x3D) && course <= static_cast<ECourse>(0x41)) {
+        return true;
+    }
+#  endif
+    return IsRaceCourse(course);
+}
+
 static bool IsBattleCourse(ECourse course)
 {
     return course >= ECourse::DELFINO_PIER && course <= ECourse::N64_SKYSCRAPER;
